# Copy to .env and fill in. Nothing here is required to run the service:
# with no key the app starts on the offline extractive provider.

# Comma separated. Several keys are rotated when one is rate limited.
GROQ_API_KEYS=

LLM_PROVIDER=auto            # auto | groq | mock
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
USE_MODEL_GUARD=true
GUARD_THRESHOLD=0.8

EMBEDDING_BACKEND=auto       # auto | sentence_transformer | tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RETRIEVAL_TOP_K=6
CANDIDATE_POOL=20
HYBRID_ALPHA=0.5
RRF_K=20
MMR_LAMBDA=0.7
MIN_RELEVANCE_SCORE=0.28
USE_RERANKER=false

CHUNK_SIZE=450
CHUNK_OVERLAP=80

MEMORY_MAX_TURNS=6
MEMORY_TTL_SECONDS=1800

RATE_LIMIT_PER_MINUTE=30
REQUIRE_API_KEY=false
API_KEYS=
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=local
